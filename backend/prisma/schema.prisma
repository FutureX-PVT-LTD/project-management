generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  functionalRoleLinks UserFunctionalRole[]
  additionalWork      AdditionalWork[]
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  jobTitle            String?
  avatarUrl           String?
  globalRole          String               @default("TEAM_MEMBER") // OWNER, ADMIN, TEAM_MEMBER
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Relations
  teamMemberships           TeamMember[]
  ledTeams                  Team[]                   @relation("TeamLead")
  managedProjects           Project[]                @relation("ProjectManager")
  projectMemberships        ProjectMember[]
  createdTasks              Task[]                   @relation("TaskCreator")
  assignedTasks             Task[]                   @relation("TaskAssignee")
  taskCollaborations        TaskCollaborator[]
  taskComments              TaskComment[]
  taskAttachments           TaskAttachment[]
  taskActivities            TaskActivity[]
  taskDailyUpdates          TaskDailyUpdate[]
  taskReviews               TaskReview[]
  projectUpdates            ProjectUpdate[]
  notifications             Notification[]
  auditLogs                 AuditLog[]               @relation("ActorAuditLogs")
  sessions                  Session[]
  marketingOwnedProjects    Project[]                @relation("MarketingOwner")
  marketingChannelsAsBackup MarketingChannel[]       @relation("ChannelBackupAdmin")
  marketingContentItems     MarketingContentItem[]   @relation("ContentOwner")
  marketingBuzzActivities   MarketingBuzzActivity[]  @relation("BuzzOwner")
  approvedMarketingGates    MarketingGate[]          @relation("MarketingGateApprover")
  marketingSignoffItems     MarketingSignoffItem[]   @relation("SignoffOwner")
  assignmentHistoryFrom     TaskAssignmentHistory[]  @relation("PreviousAssignee")
  assignmentHistoryTo       TaskAssignmentHistory[]  @relation("NewAssignee")
  assignmentChanges         TaskAssignmentHistory[]  @relation("AssignmentChangedBy")
  defaultPhaseAssignments   ProjectPhaseAssignment[] @relation("PhaseDefaultAssignee")
  createdPhaseAssignments   ProjectPhaseAssignment[] @relation("PhaseAssignmentCreatedBy")
  updatedPhaseAssignments   ProjectPhaseAssignment[] @relation("PhaseAssignmentUpdatedBy")
  phaseMemberships          ProjectPhaseMember[]

  @@index([email])
  @@index([globalRole])
  @@index([isActive])
  @@index([resetPasswordToken])
}

model FunctionalRole {
  id             String                        @id @default(uuid())
  code           String                        @unique
  name           String
  category       String
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  users          UserFunctionalRole[]
  projectMembers ProjectMemberRoleAssignment[]
  checklistItems ChecklistEligibleRole[]

  @@unique([name, category])
  @@index([category, isActive])
  @@map("JobRole")
}

model UserFunctionalRole {
  userId           String
  functionalRoleId String
  assignedAt       DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Restrict)

  @@id([userId, functionalRoleId])
  @@index([functionalRoleId])
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  leadUserId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadUser User?        @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members  TeamMember[]

  @@index([leadUserId])
}

model TeamMember {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Project {
  additionalWork           AdditionalWork[]
  id                       String           @id @default(uuid())
  key                      String           @unique // e.g. "CR", "HM", "WEB"
  name                     String
  description              String?
  targetMarket             String?
  targetLanguage           String?
  productType              String           @default("GAME") // APP, GAME, WEBSITE_TOOL
  status                   String           @default("ACTIVE") // PLANNED, ACTIVE, AT_RISK, COMPLETED, ARCHIVED
  health                   String           @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, COMPLETED
  healthReason             String?
  manualHealthOverride     Boolean          @default(false)
  progress                 Float            @default(0) // 0-100%
  launchReadiness          Float            @default(0) // derived from checklist/stage readiness
  currentPhase             String?
  checklistGeneratedAt     DateTime?
  checklistTemplateVersion String?
  startDate                DateTime?
  targetDate               DateTime?
  completedDate            DateTime?
  projectManagerId         String?
  marketingOwnerId         String?
  lifecycleStatus          String           @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  currentStep              String?          @default("DETAILS") // DETAILS, TEAM, WORKSTREAMS, REVIEW
  draftDataJson            String?
  createdById              String?
  updatedById              String?
  activationStartedAt      DateTime?
  activatedAt              DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?

  projectManager          User?                    @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  marketingOwner          User?                    @relation("MarketingOwner", fields: [marketingOwnerId], references: [id], onDelete: SetNull)
  members                 ProjectMember[]
  milestones              Milestone[]
  tasks                   Task[]
  taskAttachments         TaskAttachment[]
  taskActivities          TaskActivity[]
  dailyUpdates            TaskDailyUpdate[]
  updates                 ProjectUpdate[]
  workstreams             ProjectWorkstream[]
  marketingChannels       MarketingChannel[]
  marketingContentItems   MarketingContentItem[]
  marketingBuzzActivities MarketingBuzzActivity[]
  marketingGates          MarketingGate[]
  marketingSignoffItems   MarketingSignoffItem[]
  phaseAssignments        ProjectPhaseAssignment[]

  @@index([key])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([createdById])
  @@index([health])
  @@index([productType])
  @@index([projectManagerId])
  @@index([marketingOwnerId])
  @@index([targetDate])
}

model ChecklistTemplateItem {
  id                String   @id @default(uuid())
  code              String   @unique // e.g. PD-01
  workstream        String   @default("DEVELOPMENT") // DEVELOPMENT, MARKETING
  phase             String
  stage             String?
  title             String
  description       String?
  doneWhen          String?
  mandatory         Boolean  @default(true)
  ownerRole         String
  defaultOrder      Int
  requiresReview    Boolean  @default(false)
  allowParallelWork Boolean  @default(false)
  dependencies      String[] @default([])
  applicableTypes   String[] @default(["APP", "GAME", "WEBSITE_TOOL"])
  targetOffsetDays  Int?
  templateVersion   String   @default("2026.09")
  isActive          Boolean  @default(true)
  sourceConfirmed   Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  generatedTasks Task[]
  eligibleRoles  ChecklistEligibleRole[]

  @@index([phase])
  @@index([workstream])
  @@index([ownerRole])
  @@index([defaultOrder])
  @@index([isActive])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // MANAGER, LEAD, MEMBER, VIEWER
  joinedAt  DateTime @default(now())

  project      Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRoles ProjectMemberRoleAssignment[]

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model ProjectMemberRoleAssignment {
  projectMemberId  String
  functionalRoleId String
  assignedAt       DateTime       @default(now())
  projectMember    ProjectMember  @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Restrict)

  @@id([projectMemberId, functionalRoleId])
  @@index([functionalRoleId])
}

model ProjectPhaseAssignment {
  id                String   @id @default(uuid())
  projectId         String
  workstream        String
  phaseKey          String
  defaultAssigneeId String?
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultAssignee User?                @relation("PhaseDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  createdBy       User                 @relation("PhaseAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                 @relation("PhaseAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  members         ProjectPhaseMember[]

  @@unique([projectId, workstream, phaseKey])
  @@index([projectId, workstream])
  @@index([defaultAssigneeId])
}

model ProjectPhaseMember {
  phaseAssignmentId String
  userId            String
  isDefault         Boolean  @default(false)
  addedAt           DateTime @default(now())

  phaseAssignment ProjectPhaseAssignment @relation(fields: [phaseAssignmentId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([phaseAssignmentId, userId])
  @@index([userId])
}

model ChecklistEligibleRole {
  checklistTemplateItemId String
  functionalRoleId        String
  isPrimary               Boolean               @default(false)
  checklistTemplateItem   ChecklistTemplateItem @relation(fields: [checklistTemplateItemId], references: [id], onDelete: Cascade)
  functionalRole          FunctionalRole        @relation(fields: [functionalRoleId], references: [id], onDelete: Restrict)

  @@id([checklistTemplateItemId, functionalRoleId])
  @@index([functionalRoleId])
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  targetDate  DateTime
  status      String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, DELAYED
  progress    Float    @default(0)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([targetDate])
  @@index([status])
}

model Task {
  id                      String    @id @default(uuid())
  taskNumber              Int
  humanId                 String    @unique // e.g. "CR-101"
  title                   String
  description             String?
  projectId               String
  milestoneId             String?
  creatorId               String
  assigneeId              String?
  workType                String    @default("CUSTOM") // STANDARD_CHECKLIST, CUSTOM
  workstream              String    @default("DEVELOPMENT") // DEVELOPMENT, MARKETING
  checklistTemplateItemId String?
  checklistCode           String?
  checklistPhase          String?
  checklistStage          String?
  checklistOwnerRole      String?
  checklistDoneWhen       String?
  checklistEvidenceUrl    String?
  checklistNotes          String?
  checklistMandatory      Boolean   @default(false)
  checklistOrder          Int?
  allowParallelWork       Boolean   @default(false)
  priority                String    @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW, NONE
  status                  String    @default("TODO") // BACKLOG, TODO, READY, IN_PROGRESS, IN_REVIEW, BLOCKED, DONE, CANCELED
  progress                Int       @default(0) // 0-100%
  estimatedHours          Float?
  actualHours             Float?
  startDate               DateTime?
  dueDate                 DateTime?
  completedDate           DateTime?
  requiresReview          Boolean   @default(false)
  isManualBlocked         Boolean   @default(false)
  manualBlockReason       String?
  parentTaskId            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone             Milestone?              @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  creator               User                    @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee              User?                   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  checklistTemplateItem ChecklistTemplateItem?  @relation(fields: [checklistTemplateItemId], references: [id], onDelete: SetNull)
  parentTask            Task?                   @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks              Task[]                  @relation("SubTasks")
  collaborators         TaskCollaborator[]
  blockedBy             TaskDependency[]        @relation("DependentTasks")
  blocking              TaskDependency[]        @relation("PredecessorTasks")
  reviews               TaskReview[]
  dailyUpdates          TaskDailyUpdate[]
  comments              TaskComment[]
  attachments           TaskAttachment[]
  activities            TaskActivity[]
  assignmentHistory     TaskAssignmentHistory[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([workType])
  @@index([workstream])
  @@index([checklistCode])
  @@index([checklistPhase])
  @@index([checklistStage])
  @@index([checklistOwnerRole])
  @@index([checklistTemplateItemId])
  @@index([dueDate])
  @@index([milestoneId])
  @@index([parentTaskId])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate, status])
}

model TaskAssignmentHistory {
  id                 String   @id @default(uuid())
  taskId             String
  previousAssigneeId String?
  newAssigneeId      String?
  changedById        String
  reason             String?
  changedAt          DateTime @default(now())
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousAssignee   User?    @relation("PreviousAssignee", fields: [previousAssigneeId], references: [id], onDelete: SetNull)
  newAssignee        User?    @relation("NewAssignee", fields: [newAssigneeId], references: [id], onDelete: SetNull)
  changedBy          User     @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId, changedAt])
  @@index([previousAssigneeId])
  @@index([newAssigneeId])
}

model TaskCollaborator {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskDependency {
  id                String   @id @default(uuid())
  predecessorTaskId String
  dependentTaskId   String
  type              String   @default("FINISH_TO_START")
  createdAt         DateTime @default(now())

  predecessorTask Task @relation("PredecessorTasks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  dependentTask   Task @relation("DependentTasks", fields: [dependentTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, dependentTaskId])
  @@index([predecessorTaskId])
  @@index([dependentTaskId])
}

model TaskReview {
  id         String   @id @default(uuid())
  taskId     String
  reviewerId String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  feedback   String?
  reviewedAt DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id])

  @@index([taskId])
  @@index([reviewerId])
}

model TaskDailyUpdate {
  id             String   @id @default(uuid())
  taskId         String
  projectId      String
  userId         String
  progressBefore Int
  progressAfter  Int
  completedToday String
  blocker        String?
  nextStep       String
  attachmentId   String?
  workDate       DateTime @default(now()) @db.Date
  createdAt      DateTime @default(now())

  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  attachment TaskAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@unique([taskId, userId, workDate])
  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String?
  projectId  String
  uploaderId String
  fileName   String
  fileKey    String
  fileUrl    String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  task         Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User              @relation(fields: [uploaderId], references: [id])
  dailyUpdates TaskDailyUpdate[]

  @@index([taskId])
  @@index([projectId])
  @@index([uploaderId])
}

model TaskActivity {
  id           String   @id @default(uuid())
  taskId       String?
  projectId    String
  userId       String
  actionType   String
  description  String
  metadataJson String?
  createdAt    DateTime @default(now())

  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  authorId  String
  health    String
  note      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  linkUrl      String?
  isRead       Boolean   @default(false)
  readAt       DateTime?
  metadataJson String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  detailsJson String?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model AdditionalWork {
  id                          String   @id @default(uuid())
  projectId                   String
  creatorId                   String
  title                       String
  description                 String
  workDate                    DateTime @db.Date
  minutesSpent                Int?
  workstream                  String   @default("DEVELOPMENT") // DEVELOPMENT, MARKETING
  source                      String   @default("MEMBER_ADDITIONAL_WORK")
  countsTowardProductProgress Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator User    @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, workDate])
  @@index([projectId, workDate])
}

model ProjectWorkstream {
  id              String    @id @default(uuid())
  projectId       String
  workstream      String
  templateVersion String?
  status          String    @default("SETUP") // SETUP, ACTIVE, READY, DISABLED
  generatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, workstream])
  @@index([workstream, status])
}

model MarketingChannel {
  id               String   @id @default(uuid())
  projectId        String
  code             String
  platform         String
  requirement      String   @default("WHEN_APPLICABLE")
  handle           String?
  publicUrl        String?
  adminEmail       String?
  twoFactorEnabled Boolean  @default(false)
  backupAdminId    String?
  status           String   @default("NOT_CREATED")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backupAdmin User?   @relation("ChannelBackupAdmin", fields: [backupAdminId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, status])
}

model MarketingContentItem {
  id            String    @id @default(uuid())
  projectId     String
  code          String
  stage         String
  contentType   String
  concept       String
  platforms     String[]  @default([])
  ownerId       String?
  assetStatus   String    @default("NOT_STARTED")
  postStatus    String    @default("NOT_POSTED")
  assetLink     String?
  notes         String?
  targetDate    DateTime?
  scheduledDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, assetStatus])
  @@index([ownerId])
}

model MarketingBuzzActivity {
  id              String   @id @default(uuid())
  projectId       String
  code            String
  stage           String
  objective       String
  startOffsetDays Int
  endOffsetDays   Int
  startDate       DateTime
  endDate         DateTime
  platforms       String[] @default([])
  ownerId         String?
  status          String   @default("NOT_STARTED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("BuzzOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, startDate])
  @@index([ownerId])
}

model MarketingGate {
  id           String    @id @default(uuid())
  projectId    String
  code         String
  name         String
  requirement  String
  status       String    @default("NOT_READY")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("MarketingGateApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, status])
}

model MarketingSignoffItem {
  id             String    @id @default(uuid())
  projectId      String
  code           String
  checkName      String
  requirement    String
  marketingCheck String    @default("PENDING")
  pmCheck        String    @default("PENDING")
  issueGap       String?
  ownerId        String?
  targetFixDate  DateTime?
  finalStatus    String    @default("PENDING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("SignoffOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId, finalStatus])
}
