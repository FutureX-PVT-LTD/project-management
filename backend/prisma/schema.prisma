generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  jobTitle     String?
  avatarUrl    String?
  globalRole   String    @default("TEAM_MEMBER") // OWNER, ADMIN, PROJECT_MANAGER, TEAM_MEMBER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Relations
  teamMemberships    TeamMember[]
  ledTeams           Team[]             @relation("TeamLead")
  managedProjects    Project[]          @relation("ProjectManager")
  projectMemberships ProjectMember[]
  createdTasks       Task[]             @relation("TaskCreator")
  assignedTasks      Task[]             @relation("TaskAssignee")
  taskCollaborations TaskCollaborator[]
  taskComments       TaskComment[]
  taskAttachments    TaskAttachment[]
  taskActivities     TaskActivity[]
  taskReviews        TaskReview[]
  projectUpdates     ProjectUpdate[]
  notifications      Notification[]
  auditLogs          AuditLog[]         @relation("ActorAuditLogs")
  sessions           Session[]

  @@index([email])
  @@index([globalRole])
  @@index([isActive])
  @@index([resetPasswordToken])
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  leadUserId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadUser User?        @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members  TeamMember[]

  @@index([leadUserId])
}

model TeamMember {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Project {
  id                   String    @id @default(uuid())
  key                  String    @unique // e.g. "CR", "HM", "WEB"
  name                 String
  description          String?
  status               String    @default("ACTIVE") // PLANNED, ACTIVE, AT_RISK, COMPLETED, ARCHIVED
  health               String    @default("ON_TRACK") // ON_TRACK, AT_RISK, OFF_TRACK, COMPLETED
  healthReason         String?
  manualHealthOverride Boolean   @default(false)
  progress             Float     @default(0) // 0-100%
  startDate            DateTime?
  targetDate           DateTime?
  completedDate        DateTime?
  projectManagerId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  projectManager  User?            @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  members         ProjectMember[]
  milestones      Milestone[]
  tasks           Task[]
  taskAttachments TaskAttachment[]
  taskActivities  TaskActivity[]
  updates         ProjectUpdate[]

  @@index([key])
  @@index([status])
  @@index([health])
  @@index([projectManagerId])
  @@index([targetDate])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // MANAGER, LEAD, MEMBER, VIEWER
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  targetDate  DateTime
  status      String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, DELAYED
  progress    Float    @default(0)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([targetDate])
  @@index([status])
}

model Task {
  id                 String    @id @default(uuid())
  taskNumber         Int
  humanId            String    @unique // e.g. "CR-101"
  title              String
  description        String?
  projectId          String
  milestoneId        String?
  creatorId          String
  assigneeId         String?
  priority           String    @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW, NONE
  status             String    @default("TODO") // BACKLOG, TODO, READY, IN_PROGRESS, IN_REVIEW, BLOCKED, DONE, CANCELED
  progress           Int       @default(0) // 0-100%
  estimatedHours     Float?
  actualHours        Float?
  startDate          DateTime?
  dueDate            DateTime?
  completedDate      DateTime?
  requiresReview     Boolean   @default(false)
  isManualBlocked    Boolean   @default(false)
  manualBlockReason  String?
  parentTaskId       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  creator       User               @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTask    Task?              @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks      Task[]             @relation("SubTasks")
  collaborators TaskCollaborator[]
  blockedBy     TaskDependency[]   @relation("DependentTasks")
  blocking      TaskDependency[]   @relation("PredecessorTasks")
  reviews       TaskReview[]
  comments      TaskComment[]
  attachments   TaskAttachment[]
  activities    TaskActivity[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([milestoneId])
  @@index([parentTaskId])
}

model TaskCollaborator {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model TaskDependency {
  id                String   @id @default(uuid())
  predecessorTaskId String
  dependentTaskId   String
  type              String   @default("FINISH_TO_START")
  createdAt         DateTime @default(now())

  predecessorTask Task @relation("PredecessorTasks", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  dependentTask   Task @relation("DependentTasks", fields: [dependentTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, dependentTaskId])
  @@index([predecessorTaskId])
  @@index([dependentTaskId])
}

model TaskReview {
  id         String   @id @default(uuid())
  taskId     String
  reviewerId String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  feedback   String?
  reviewedAt DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id])

  @@index([taskId])
  @@index([reviewerId])
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  isEdited  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String?
  projectId  String
  uploaderId String
  fileName   String
  fileKey    String
  fileUrl    String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  task     Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([uploaderId])
}

model TaskActivity {
  id           String   @id @default(uuid())
  taskId       String?
  projectId    String
  userId       String
  actionType   String
  description  String
  metadataJson String?
  createdAt    DateTime @default(now())

  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String
  authorId  String
  health    String
  note      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  type         String
  title        String
  message      String
  linkUrl      String?
  isRead       Boolean   @default(false)
  readAt       DateTime?
  metadataJson String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  detailsJson String?
  createdAt   DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}
