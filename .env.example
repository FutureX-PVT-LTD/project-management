# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futurex_pm?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
WEB_URL="http://localhost:3000"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
HOST="127.0.0.1"
TRUST_PROXY="false"
# Production: HTTPS origin, COOKIE_SECURE=true, independent random JWT secrets.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CORS_ORIGIN="https://projects.example.com"
POSTGRES_PASSWORD=""

# Initial Admin Account Seed Configuration


# Node Environment
NODE_ENV="development"
