# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futurex_pm?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET="futurex_super_secure_jwt_access_secret_key_2026_!@#"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="futurex_super_secure_jwt_refresh_secret_key_2026_!@#"
JWT_REFRESH_EXPIRES_IN="7d"

# App Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
WEB_URL="http://localhost:3000"

# Initial Admin Account Seed Configuration
ADMIN_SEED_NAME="FutureX Admin"
ADMIN_SEED_EMAIL="admin@futurex.com"
ADMIN_SEED_PASSWORD="AdminPassword2026!@#"

# Node Environment
NODE_ENV="development"